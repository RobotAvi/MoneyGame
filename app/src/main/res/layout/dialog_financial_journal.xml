<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_cartoon_calendar">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="0dp">

        <!-- Заголовок -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_cartoon_header"
            android:padding="20dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📊 Финансовый журнал"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/cartoon_text_secondary"
                android:fontFamily="cursive" />
        </LinearLayout>

        <!-- Статистика -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="@color/cartoon_card"
            app:strokeColor="@color/cartoon_primary"
            app:strokeWidth="3dp">
            <TextView
                android:id="@+id/tvJournalStats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_cartoon_calendar"
                android:padding="16dp"
                android:text="📊 СТАТИСТИКА:\n\n➕ Общие доходы: 0₽\n➖ Общие расходы: 0₽\n💰 Чистый результат: 0₽"
                android:textSize="15sp"
                android:textColor="@color/cartoon_text_primary"
                android:fontFamily="cursive" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Кнопка экспорта -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExportTxt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="16dp"
            android:text="📤 Экспорт в TXT"
            android:textSize="16sp"
            android:padding="12dp"
            android:textColor="@color/cartoon_text_secondary"
            android:fontFamily="cursive"
            android:background="@drawable/bg_cartoon_button_opportunities"
            app:icon="@android:drawable/ic_menu_share"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:cornerRadius="20dp" />

        <!-- Список записей -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewJournal"
            android:layout_width="match_parent"
            android:layout_height="400dp"
            android:scrollbars="vertical"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="16dp" />
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>