<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="0dp"
    android:layout_height="0dp"
    android:minWidth="40dp"
    android:minHeight="40dp"
    android:layout_margin="4dp"
    app:cardCornerRadius="0dp"
    app:cardUseCompatPadding="true"
    app:cardElevation="4dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/primary_color"
    android:contentDescription="Карточка дня">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <View
            android:id="@+id/vColorStrip"
            android:layout_width="4dp"
            android:layout_height="match_parent"
            android:background="@color/primary_color"
            android:contentDescription="Цветовой индикатор типа дня" />

        <FrameLayout
            android:id="@+id/dayContainer"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="4dp">
            <!-- android:background="@drawable/bg_glass_card" -->

            <!--
            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/lottieDaySelect"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone"
                app:lottie_rawRes="@raw/day_select"
                app:lottie_autoPlay="false"
                app:lottie_loop="false" />
            -->

            <ImageView
                android:id="@+id/ivDayIcon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:contentDescription="Иконка дня"
                android:scaleType="centerInside"
                android:tint="@color/primary_color"
            android:alpha="0.7"
                android:src="@drawable/ic_runner" />

            <ImageView
                android:id="@+id/ivPlayerToken"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:visibility="gone"
                android:contentDescription="Токен игрока"
                android:src="@drawable/player_token" />

            <TextView
                android:id="@+id/tvDayNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="4dp"
                android:text="1"
                android:textStyle="bold"
                android:textSize="16sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/black"
                android:shadowColor="#80000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="2" />
        </FrameLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>