<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="8dp"
    app:cardElevation="8dp"
    app:cardCornerRadius="24dp"
    app:strokeColor="@color/cartoon_primary"
    app:strokeWidth="3dp"
    app:cardBackgroundColor="@color/cartoon_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="20dp"
        android:background="@drawable/bg_cartoon_calendar">

        <!-- Иконка категории -->
        <TextView
            android:id="@+id/tv_category_icon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/bg_cartoon_circle"
            android:gravity="center"
            android:text="💼"
            android:textSize="22sp" />

        <!-- Основная информация -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Название категории и сумма -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_category_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Зарплата"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/cartoon_text_primary"
                    android:fontFamily="cursive" />

                <TextView
                    android:id="@+id/tv_amount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+50,000₽"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/cartoon_income"
                    android:fontFamily="cursive" />

            </LinearLayout>

            <!-- Описание -->
            <TextView
                android:id="@+id/tv_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Зарплата за месяц"
                android:textSize="14sp"
                android:textColor="@color/cartoon_text_secondary"
                android:fontFamily="cursive" />

            <!-- Время, возраст и месяц -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_time_age"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="14.07 15:30 • 25 лет"
                    android:textSize="12sp"
                    android:textColor="@color/cartoon_text_secondary"
                    android:fontFamily="cursive" />

                <TextView
                    android:id="@+id/tv_month"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Месяц 1"
                    android:textSize="12sp"
                    android:textColor="@color/cartoon_text_secondary"
                    android:fontFamily="cursive" />

            </LinearLayout>

            <!-- Баланс после операции -->
            <TextView
                android:id="@+id/tv_balance_after"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Баланс: 55,000₽"
                android:textSize="12sp"
                android:textStyle="italic"
                android:textColor="@color/cartoon_text_secondary"
                android:fontFamily="cursive" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>