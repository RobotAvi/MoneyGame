<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/background_color">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="0dp">

        <!-- Заголовок -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/primary_color"
            android:padding="20dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Состояние здоровья"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/white" />
        </LinearLayout>

        <!-- Общий статус -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp">
            <TextView
                android:id="@+id/tvHealthStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:text="🟢 Здоров"
                android:textSize="16sp"
                android:textColor="@color/success_color" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Активные риски -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Активные профессиональные риски"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/error_color"
                    android:layout_marginBottom="8dp" />
                <TextView
                    android:id="@+id/tvActiveRisks"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Нет активных профессиональных рисков"
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Возможные риски профессии -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Возможные риски профессии"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/warning_color"
                    android:layout_marginBottom="8dp" />
                <TextView
                    android:id="@+id/tvPossibleRisks"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Нет рисков"
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Кнопка профилактики -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnHealthcare"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Профилактика и лечение"
            android:textSize="16sp"
            android:layout_marginHorizontal="24dp"
            android:layout_marginBottom="24dp"
            style="@style/Widget.Material3.Button" />
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>