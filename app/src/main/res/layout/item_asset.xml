<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="12dp"
    app:cardElevation="8dp"
    app:cardCornerRadius="24dp"
    app:strokeColor="@color/cartoon_primary"
    app:strokeWidth="3dp"
    app:cardBackgroundColor="@color/cartoon_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="20dp"
        android:background="@drawable/bg_cartoon_calendar">

        <ImageView
            android:id="@+id/iv_asset_icon"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginEnd="20dp"
            android:scaleType="centerCrop"
            android:background="@drawable/bg_cartoon_circle"
            android:padding="12dp"
            android:contentDescription="Иконка актива" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_asset_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💰 Название актива"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/cartoon_text_primary"
                android:layout_marginBottom="4dp"
                android:fontFamily="cursive" />

            <TextView
                android:id="@+id/tv_asset_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Тип актива"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="4dp">

                <TextView
                    android:id="@+id/tv_asset_value"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Стоимость: 0 ₽"
                    android:textSize="14sp"
                    android:textColor="@color/primary_color" />

                <TextView
                    android:id="@+id/tv_cash_flow"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Поток: +0 ₽"
                    android:textSize="14sp"
                    android:textColor="@color/success_color"
                    android:gravity="end" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_roi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ROI: 0.0%"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/success_color"
                android:layout_marginTop="2dp" />

            <TextView
                android:id="@+id/tv_shares"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>