<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_profession"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="12dp"
    android:checkable="true"
    app:cardElevation="8dp"
    app:cardCornerRadius="24dp"
    app:strokeColor="@color/cartoon_primary"
    app:strokeWidth="3dp"
    app:cardBackgroundColor="@color/cartoon_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="20dp"
        android:background="@drawable/bg_cartoon_calendar">

        <ImageView
            android:id="@+id/iv_profession_icon"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginEnd="20dp"
            android:scaleType="centerCrop"
            android:background="@drawable/bg_cartoon_circle"
            android:padding="12dp"
            android:contentDescription="Иконка профессии" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_profession_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Профессия"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/cartoon_text_primary"
                android:layout_marginBottom="4dp"
                android:fontFamily="cursive" />

            <TextView
                android:id="@+id/tv_profession_description"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Описание профессии"
                android:textSize="14sp"
                android:textColor="@color/cartoon_text_secondary"
                android:layout_marginBottom="8dp"
                android:fontFamily="cursive" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_salary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="💰 Зарплата: 0 ₽"
                        android:textSize="13sp"
                        android:textColor="@color/cartoon_income"
                        android:fontFamily="cursive" />

                    <TextView
                        android:id="@+id/tv_expenses"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="💸 Расходы: 0 ₽"
                        android:textSize="13sp"
                        android:textColor="@color/cartoon_expenses"
                        android:fontFamily="cursive" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tv_education"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🎓 Образование"
                    android:textSize="13sp"
                    android:textColor="@color/cartoon_text_secondary"
                    android:gravity="end"
                    android:fontFamily="cursive" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>