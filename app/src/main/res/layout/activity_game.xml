<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_cartoon_gradient">

    <!-- Верхняя панель -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/headerPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
                 android:background="@color/cartoon_header_bg"
        android:padding="20dp"
        app:elevation="4dp">

        <!-- Шапка: ИКОНКА ПРОФЕССИИ, ИКОНКА МЕЧТЫ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="8dp"
            android:background="@drawable/bg_cartoon_header">



            <!-- ИКОНКА ПРОФЕССИИ -->
            <ImageView
                android:id="@+id/iv_profession_icon"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/ic_teacher"
                android:contentDescription="Иконка профессии"
                android:background="@drawable/bg_cartoon_circle"
                android:padding="8dp"
                android:layout_marginEnd="20dp" />

            <!-- ЦЕНТРАЛЬНАЯ ИНФОРМАЦИЯ -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <!-- ИМЯ И ВОЗРАСТ -->
                <TextView
                    android:id="@+id/tv_player_name_age"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Иван, 25 лет"
                    android:textColor="@color/cartoon_text_secondary"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:fontFamily="cursive"
                    android:shadowColor="#66FFFFFF"
                    android:shadowDx="2"
                    android:shadowDy="2"
                    android:shadowRadius="4" />

                <!-- ЦЕЛЬ (3 ТИПА) -->
                <TextView
                    android:id="@+id/tv_financial_goal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Цель: Накопить 1,000,000₽"
                    android:textColor="@color/cartoon_text_secondary"
                    android:textSize="16sp"
                    android:gravity="center"
                    android:layout_marginTop="8dp"
                    android:fontFamily="cursive"
                    android:background="@drawable/bg_cartoon_goal"
                    android:padding="8dp" />
            </LinearLayout>

            <!-- ИКОНКА МЕЧТЫ справа -->
            <ImageView
                android:id="@+id/iv_dream_icon"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:contentDescription="Иконка мечты"
                android:scaleType="fitCenter"
                android:background="@drawable/bg_cartoon_circle"
                android:padding="8dp"
                android:layout_marginStart="20dp" />
        </LinearLayout>

        <!-- ШКАЛА ЖИЗНИ (мультяшная) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_cartoon_life_track"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="👶 0"
                    android:textColor="@color/cartoon_text_primary"
                    android:textSize="14sp"
                    android:layout_marginEnd="12dp"
                    android:fontFamily="cursive" />

                <ProgressBar
                    android:id="@+id/progress_life"
                    style="@style/Widget.App.ProgressBar.Cartoon"
                    android:layout_width="0dp"
                    android:layout_height="16dp"
                    android:layout_weight="1"
                    android:progress="30"
                    android:max="100" />

                <TextView
                    android:id="@+id/tv_death_age"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💀 85"
                    android:textColor="@color/cartoon_text_primary"
                    android:textSize="14sp"
                    android:layout_marginStart="12dp"
                    android:fontFamily="cursive" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Контент -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/contentScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        android:clipToPadding="false"
        android:paddingBottom="88dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="16dp">

            <!-- КАЛЕНДАРЬ (мультяшный стиль) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_calendar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardElevation="8dp"
                app:cardCornerRadius="24dp"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/cartoon_card"
                app:strokeColor="@color/cartoon_primary"
                app:strokeWidth="3dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:background="@drawable/bg_cartoon_calendar">

                    <!-- Заголовок с ПОЛНОЙ ДАТОЙ -->
                    <TextView
                        android:id="@+id/tvMonthLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text=""
                        android:textStyle="bold"
                        android:textColor="@color/cartoon_text_primary"
                        android:textSize="24sp"
                        android:layout_marginBottom="20dp"
                        android:fontFamily="cursive"
                        android:background="@drawable/bg_cartoon_month_header"
                        android:padding="12dp" />

                    <!-- ЗАГОЛОВКИ ДНЕЙ НЕДЕЛИ (мультяшные) -->
                    <LinearLayout
                        android:id="@+id/weekdays_header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="16dp">

                        <!-- ПН-ПТ МУЛЬТЯШНЫМ -->
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="Пн"
                            android:textColor="@color/cartoon_weekday"
                            android:textStyle="bold"
                            android:textSize="16sp"
                            android:fontFamily="cursive" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="Вт"
                            android:textColor="@color/cartoon_weekday"
                            android:textStyle="bold"
                            android:textSize="16sp"
                            android:fontFamily="cursive" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="Ср"
                            android:textColor="@color/cartoon_weekday"
                            android:textStyle="bold"
                            android:textSize="16sp"
                            android:fontFamily="cursive" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="Чт"
                            android:textColor="@color/cartoon_weekday"
                            android:textStyle="bold"
                            android:textSize="16sp"
                            android:fontFamily="cursive" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="Пт"
                            android:textColor="@color/cartoon_weekday"
                            android:textStyle="bold"
                            android:textSize="16sp"
                            android:fontFamily="cursive" />

                        <!-- СУББОТА - МУЛЬТЯШНО КРАСНЫМ -->
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="Сб"
                            android:textColor="@color/cartoon_weekend"
                            android:textStyle="bold"
                            android:textSize="16sp"
                            android:fontFamily="cursive" />

                        <!-- ВОСКРЕСЕНЬЕ - МУЛЬТЯШНО КРАСНЫМ -->
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="Вс"
                            android:textColor="@color/cartoon_weekend"
                            android:textStyle="bold"
                            android:textSize="16sp"
                            android:fontFamily="cursive" />
                    </LinearLayout>

                    <!-- Календарная сетка -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recyclerCalendar"
                        android:layout_width="match_parent"
                        android:layout_height="280dp"
                        android:nestedScrollingEnabled="false" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Скрытые элементы для совместимости -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_balance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_marginBottom="16dp"
                app:cardElevation="8dp"
                app:cardCornerRadius="20dp"
                app:strokeColor="@color/primary_color"
                app:strokeWidth="2dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <TextView
                        android:id="@+id/tv_cash"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="100 000₽"
                        android:textSize="32sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary_color"
                        android:drawableLeft="@drawable/ic_action_assets"
                        android:drawablePadding="8dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="12dp">

                        <TextView
                            android:id="@+id/tv_salary"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Зарплата: 130 000₽"
                            android:textSize="14sp"
                            android:textColor="@color/text_secondary" />

                        <TextView
                            android:id="@+id/tv_passive_income"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Пассивный: 0₽"
                            android:textSize="14sp"
                            android:textColor="@color/success_color" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="4dp">

                        <TextView
                            android:id="@+id/tv_expenses"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Расходы: 100 000₽"
                            android:textSize="14sp"
                            android:textColor="@color/expense_red" />

                        <TextView
                            android:id="@+id/tv_cash_flow"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Поток: 30 000₽"
                            android:textSize="14sp"
                            android:textColor="@color/primary_color" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Панель событий под календарём (MotionLayout) -->
            <androidx.constraintlayout.motion.widget.MotionLayout
                android:id="@+id/eventMotion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:layoutDescription="@xml/event_panel_scene">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_event_panel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="8dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/primary_color">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/tvEventTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Событие"
                            android:textStyle="bold"
                            android:textSize="18sp"
                            android:textColor="@color/text_primary" />

                        <TextView
                            android:id="@+id/tvEventMessage"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Описание события"
                            android:textSize="14sp"
                            android:textColor="@color/text_secondary" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="end"
                            android:layout_marginTop="12dp">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnEventSecondary"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Отмена"
                                style="@style/Widget.App.Button" />

                            <Space
                                android:layout_width="12dp"
                                android:layout_height="1dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnEventPrimary"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Действие"
                                style="@style/Widget.App.Button" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </androidx.constraintlayout.motion.widget.MotionLayout>

            <!-- Скрытые служебные элементы -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnHealthStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Здоровье"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerViewAssets"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvHealthStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Статус здоровья"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvTrackInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Информация о треке"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvFinishGoal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Финальная цель"
                android:visibility="gone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ПОДВАЛ: 4 МУЛЬТЯШНЫЕ КНОПКИ -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/bottom_actions"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_gravity="bottom"
        android:padding="16dp"
        app:cardCornerRadius="32dp"
        app:cardElevation="16dp"
        app:cardBackgroundColor="@color/cartoon_surface"
        app:strokeColor="@color/cartoon_primary"
        app:strokeWidth="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="horizontal">

            <!-- ФИНАНСЫ (мультяшная) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <ImageButton
                    android:id="@+id/btn_income"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_cartoon_button_income"
                    android:src="@drawable/icon_income"
                    android:scaleType="centerCrop"
                    android:clipToOutline="true"
                    android:contentDescription="Финансы"
                    android:padding="12dp" />

            </LinearLayout>

            <!-- ЗДОРОВЬЕ (мультяшная) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <ImageButton
                    android:id="@+id/btn_expenses"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_cartoon_button_expenses"
                    android:src="@drawable/icon_expenses"
                    android:scaleType="centerCrop"
                    android:clipToOutline="true"
                    android:contentDescription="Здоровье"
                    android:padding="8dp" />

            </LinearLayout>

            <!-- ВОЗМОЖНОСТИ (мультяшная) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <ImageButton
                    android:id="@+id/btn_opportunities"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_cartoon_button_opportunities"
                    android:src="@drawable/icon_cashflow"
                    android:scaleType="centerCrop"
                    android:clipToOutline="true"
                    android:contentDescription="Возможности"
                    android:padding="12dp" />

            </LinearLayout>

            <!-- СЛЕДУЮЩИЙ ХОД (мультяшная) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <ImageButton
                    android:id="@+id/btn_next_turn"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_cartoon_button_next"
                    android:src="@drawable/ic_arrow_next_cut_rope"
                    android:scaleType="centerCrop"
                    android:clipToOutline="true"
                    android:contentDescription="Следующий ход"
                    android:padding="8dp" />

            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>