<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color">

    <!-- Верхняя панель -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/headerPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primary_color"
        android:padding="20dp"
        app:elevation="4dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/primary_color"
            app:title="@string/app_name"
            app:titleTextColor="@color/white"
            app:navigationIconTint="@color/white"
            app:menu="@menu/game_actions" />

        <!-- Шапка: слева аватар+имя/профессия/возраст, справа мечта (личный остров) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="8dp">

            <ImageView
                android:id="@+id/iv_player_avatar"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/player_token"
                android:contentDescription="Аватар игрока"
                android:background="@drawable/bg_avatar_circle"
                android:layout_marginEnd="16dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_player_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Имя игрока"
                    android:textSize="18sp"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/tv_profession"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Профессия: Учитель"
                    android:textSize="14sp"
                    android:textColor="@color/white"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/tv_age"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="25 лет"
                    android:textColor="@color/white"
                    android:textSize="14sp" />

                <!-- Сохраняем текущую дату (используется в коде), меньшим шрифтом -->
                <TextView
                    android:id="@+id/tv_current_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1 Января 2024"
                    android:textSize="12sp"
                    android:textColor="@color/white"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>

            <ImageView
                android:id="@+id/iv_dream_island"
                android:layout_width="88dp"
                android:layout_height="64dp"
                android:src="@drawable/dream_island"
                android:contentDescription="Мечта: личный остров"
                android:scaleType="centerCrop"
                android:background="@drawable/card_bg"
                android:padding="4dp"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <!-- Индикатор жизни (оставлен) -->
        <ProgressBar
            android:id="@+id/progress_life"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:progress="60"
            android:max="100"
            android:progressTint="@color/success_color"
            android:backgroundTint="@color/primary_color_light"
            android:layout_marginTop="12dp" />
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Контент -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/contentScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        android:clipToPadding="false"
        android:paddingBottom="88dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp">

            <!-- Карточка баланса -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_balance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_marginBottom="16dp"
                app:cardElevation="8dp"
                app:cardCornerRadius="20dp"
                app:strokeColor="@color/primary_color"
                app:strokeWidth="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <TextView
                        android:id="@+id/tv_cash"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="100 000₽"
                        android:textSize="32sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary_color"
                        android:drawableLeft="@drawable/icon_income"
                        android:drawablePadding="8dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="12dp">

                        <TextView
                            android:id="@+id/tv_salary"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Зарплата: 130 000₽"
                            android:textSize="14sp"
                            android:textColor="@color/text_secondary" />

                        <TextView
                            android:id="@+id/tv_passive_income"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Пассивный: 0₽"
                            android:textSize="14sp"
                            android:textColor="@color/success_color" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="4dp">

                        <TextView
                            android:id="@+id/tv_expenses"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Расходы: 60 000₽"
                            android:textSize="14sp"
                            android:textColor="@color/error_color" />

                        <TextView
                            android:id="@+id/tv_cash_flow"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Поток: 40 000₽"
                            android:textSize="14sp"
                            android:textColor="@color/success_color" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Игровое поле (скрыто, чтобы не мешать новому дизайну, но оставить id для кода) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardElevation="4dp"
                app:cardCornerRadius="16dp"
                android:layout_marginBottom="16dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tv_game_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🐀 Крысиные бега"
                        android:textSize="16sp"
                        android:textColor="@color/primary_color"
                        android:textStyle="bold"
                        android:layout_gravity="center_horizontal" />

                    <LinearLayout
                        android:id="@+id/ll_game_track"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="8dp">

                        <LinearLayout
                            android:id="@+id/ll_track_line"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:orientation="horizontal"
                            android:background="@drawable/track_line"
                            android:gravity="center_vertical">

                            <ImageView
                                android:id="@+id/iv_player_on_track"
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:src="@drawable/ic_runner"
                                android:contentDescription="Игрок на дорожке" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Календарь на 4 недели (7x4) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_calendar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardElevation="4dp"
                app:cardCornerRadius="16dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Календарь (4 недели)"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:layout_marginBottom="8dp" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recyclerCalendar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Скрытые служебные элементы -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnHealthStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Здоровье"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerViewAssets"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvHealthStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Статус здоровья"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvTrackInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Информация о треке"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvFinishGoal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Финальная цель"
                android:visibility="gone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Нижняя панель из 4 круглых кнопок -->
    <LinearLayout
        android:id="@+id/bottom_actions"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_gravity="bottom"
        android:background="@color/white"
        android:padding="12dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnUp"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/btn_circle_bg"
            android:src="@android:drawable/arrow_up_float"
            android:scaleType="center"
            android:contentDescription="Повышение"
            android:padding="12dp"
            android:tint="@color/success_color"
            app:tint="@color/success_color" />

        <Space
            android:layout_width="16dp"
            android:layout_height="1dp" />

        <ImageButton
            android:id="@+id/btnDown"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/btn_circle_bg"
            android:src="@android:drawable/arrow_down_float"
            android:scaleType="center"
            android:contentDescription="Понижение"
            android:padding="12dp"
            android:tint="@color/error_color"
            app:tint="@color/error_color" />

        <Space
            android:layout_width="16dp"
            android:layout_height="1dp" />

        <ImageButton
            android:id="@+id/btnChart"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/btn_circle_bg"
            android:src="@drawable/ic_finance_logo"
            android:scaleType="center"
            android:contentDescription="Статистика и отчёты"
            android:padding="12dp"
            android:tint="@color/primary_color"
            app:tint="@color/primary_color" />

        <Space
            android:layout_width="16dp"
            android:layout_height="1dp" />

        <ImageButton
            android:id="@+id/btnDice"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/btn_circle_bg"
            android:src="@drawable/dice_1"
            android:scaleType="centerCrop"
            android:contentDescription="Бросить кубик"
            android:padding="8dp" />
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>