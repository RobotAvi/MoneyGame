<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Океанский фон -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/ocean"
        android:scaleType="centerCrop" />

    <TextView
        android:id="@+id/tvStepTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ШАГ 1/3"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@color/asset_blue"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="48dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_gravity="center">

        <EditText
            android:id="@+id/etPlayerName"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:hint="Введите имя"
            android:textSize="22sp"
            android:maxLength="20"
            android:inputType="textPersonName"
            android:gravity="center"
            android:textColor="@color/white"
            android:textColorHint="@color/white" />

        <!-- Дата рождения -->
        <LinearLayout
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="16dp">

            <EditText
                android:id="@+id/etBirthDate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Дата рождения (дд.мм.гггг)"
                android:inputType="date"
                android:textSize="18sp"
                android:textColor="@color/white"
                android:textColorHint="@color/white" />

            <Button
                android:id="@+id/btnPickBirthDate"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:text="📅"
                android:textSize="16sp"
                android:textColor="@color/white"
                android:background="@drawable/btn_circle_bg" />
        </LinearLayout>

        <!-- Дата начала игры -->
        <LinearLayout
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="12dp">

            <EditText
                android:id="@+id/etStartDate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Дата начала игры (дд.мм.гггг)"
                android:inputType="date"
                android:textSize="18sp"
                android:textColor="@color/white"
                android:textColorHint="@color/white" />

            <Button
                android:id="@+id/btnPickStartDate"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:text="📅"
                android:textSize="16sp"
                android:textColor="@color/white"
                android:background="@drawable/btn_circle_bg" />
        </LinearLayout>
    </LinearLayout>

    <Button
        android:id="@+id/btnNextName"
        android:layout_width="200dp"
        android:layout_height="60dp"
        android:text="Далее"
        android:textSize="20sp"
        android:background="@drawable/btn_primary_bg"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="64dp" />
</FrameLayout>