<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    
    <!-- Прозрачный фон -->
    <item>
        <shape android:shape="oval">
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
    
    <!-- Основная форма монеты -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#FFD700" />
            <stroke android:color="#FFA500" android:width="2dp" />
        </shape>
    </item>
    
    <!-- Внутренний круг для объема -->
    <item android:left="4dp" android:top="4dp" android:right="4dp" android:bottom="4dp">
        <shape android:shape="oval">
            <solid android:color="#FFA500" />
        </shape>
    </item>
    
    <!-- Центральный круг -->
    <item android:left="8dp" android:top="8dp" android:right="8dp" android:bottom="8dp">
        <shape android:shape="oval">
            <solid android:color="#FFD700" />
        </shape>
    </item>
    
    <!-- Символ доллара -->
    <item android:left="12dp" android:top="12dp" android:right="12dp" android:bottom="12dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFA500" />
            <corners android:radius="2dp" />
        </shape>
    </item>
    
</layer-list>
